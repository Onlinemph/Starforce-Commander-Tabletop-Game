node_modules/
dist/
*.local
.DS_Store
.vite/
tsconfig.tsbuildinfo
.wrangler/
# Measurement probes: throwaway season/tournament harnesses, never committed
src/*-probe.test.ts
# Self-play training sets and fitted models: regenerable, tens of megabytes,
# and no model ships (see src/engine/plotModel.ts).
#
# Anchored to the repository root, and that leading slash is load-bearing: a
# bare `data/` matches a directory of that name at ANY depth, which silently
# swallowed `src/data/` — the game's own ship, scenario and fighter data. The
# files already tracked there kept working, so nothing complained locally; a
# NEW one was ignored by `git add -A` without a word, and the first anyone knew
# was CI failing to resolve `../data/fighters` on a file that existed on every
# developer's disk.
/data/
/models/
# Ship-book importer intermediates. The RAW extractions (ships_raw.json,
# aurelian_raw.json, msl.json) are deliberately NOT ignored: the book PDFs
# live outside the repo and once left with a container recycle, and without
# the raws the canon roster cannot be regenerated. Commit them the next time
# the books are extracted. ships_final.json is a pure build output.
tools/ships_final.json
tools/__pycache__/
# Point-calibration sweep outputs: regenerable by re-running the harness
tools/calibration_results.csv
tools/repriced_draft.json
tools/titration_results.csv
tools/validation_results.csv
tools/validation2_results.csv
tools/titration_admiral.csv
tools/titration_admiral_kill.csv
tools/titration_carrier.csv
tools/duel_results.csv
tools/validation_admiral.csv
tools/repriced_draft2.json
# The two firing-rule arms: base game and Coordinated Fire (H4)
tools/titration_h4off.csv
tools/titration_h4on.csv
tools/calib_h4off.csv
tools/calib_h4on.csv
# H4's group-size limit is Tactical Scan, and Tactical Scan climbs with tech
tools/scan_tier.csv
# UI screenshots: regenerable evidence from tools/shots/capture.mjs, and PNGs
# of a whole app are megabytes that would bloat the history for no gain.
/shots/
