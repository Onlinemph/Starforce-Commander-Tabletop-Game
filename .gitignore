node_modules/
dist/
*.local
.DS_Store
.vite/
tsconfig.tsbuildinfo
.wrangler/
# Measurement probes: throwaway season/tournament harnesses, never committed
src/*-probe.test.ts
# Self-play training sets and fitted models: regenerable, tens of megabytes,
# and no model ships (see src/engine/plotModel.ts).
#
# Anchored to the repository root, and that leading slash is load-bearing: a
# bare `data/` matches a directory of that name at ANY depth, which silently
# swallowed `src/data/` — the game's own ship, scenario and fighter data. The
# files already tracked there kept working, so nothing complained locally; a
# NEW one was ignored by `git add -A` without a word, and the first anyone knew
# was CI failing to resolve `../data/fighters` on a file that existed on every
# developer's disk.
/data/
/models/
# Ship-book importer intermediates: regenerable from the PDFs in one command,
# and ships.json is the only output that belongs in the repo (see tools/README.md)
tools/msl.json
tools/ships_raw.json
tools/aurelian_raw.json
tools/ships_final.json
tools/__pycache__/
# Point-calibration sweep outputs: regenerable by re-running the harness
tools/calibration_results.csv
tools/repriced_draft.json
