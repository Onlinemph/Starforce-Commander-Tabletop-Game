{
  "name": "starforce-commander",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "A digital tabletop implementation of StarForce Commander (Mariner Games)",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "season": "vite-node tools/season-cli.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "sweep": "vite-node tools/sweep.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-node": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
